{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Role for idleZero to access limited AWS resources",
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "Description": "External ID provided by idleZero for secure cross-account access"
    }
  },
  "Resources": {
    "IdleZeroAccessRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "IdleZeroAccessRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::816881850355:role/lambda_execution_role-dev-zombie-cleaner"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "IdleZeroPermissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "ec2:StartInstances",
                    "ec2:StopInstances",
                    "ec2:TerminateInstances",
                    "lambda:InvokeFunction",
                    "lambda:ListFunctions",
                    "lambda:GetFunctionConfiguration"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Value": { "Fn::GetAtt": ["IdleZeroAccessRole", "Arn"] }
    }
  }
}