{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Role for MyApp to access limited AWS resources",
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "Description": "External ID provided by MyApp"
    }
  },
  "Resources": {
    "MyAppAccessRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "MyAppCrossAccountRole",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::YOUR_APP_ACCOUNT_ID:root"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": { "Ref": "ExternalId" }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "MyAppPermissions",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:DescribeInstances",
                    "ec2:StartInstances",
                    "ec2:StopInstances",
                    "ec2:TerminateInstances"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Value": { "Fn::GetAtt": ["MyAppAccessRole", "Arn"] }
    }
  }
}